# Template for .env.mainnet. Copy to .env.mainnet and fill in every value:
#
#     cp .env.mainnet.example .env.mainnet
#     $EDITOR .env.mainnet
#
# .env.mainnet is gitignored (`.env.*` at .gitignore:17); .env.mainnet.example
# is allowlisted (`!.env.mainnet.example` right below it). Never commit real
# secrets — provider URLs typically carry an API key in the path, and one
# leaked private key drains real capital.
#
# Read by deploy/vault-service.sh, deploy/enter-loop.sh and
# deploy/run-live-demo.sh under TARGET=mainnet, and by apps/loop-server at
# boot. A missing value halts the run before anything is signed
# (deploy/target.sh:required_env, apps/loop-server/src/env.ts:required).
#
# To load and run:
#   env $(grep -v '^#' .env.mainnet | xargs) TARGET=mainnet deploy/vault-service.sh

# ---- chain access ----------------------------------------------------------

# Base mainnet HTTPS endpoint. Alchemy/QuickNode/etc. Rate-limit matters more
# on live than on Sepolia because operators submit one on-chain tx per strike.
PRIIME_RPC_URL=

# Optional websocket endpoint; if absent, vault-service.sh derives wss:// from
# PRIIME_RPC_URL by substitution. Set explicitly if your provider serves ws on
# a different host.
# PRIIME_WS_URL=

# ---- role keys (0x + 32-byte hex each) ------------------------------------

# owner: deploys and owns the POA service manager + PriimeVault handler(s).
# Pays deploy gas. Must hold ~0.01 ETH before the first run.
PRIIME_OWNER_KEY=

# strategist: the only account vault.execute() accepts. Signs enter-loop.sh's
# turn calls. For the demo you may reuse the owner key here.
PRIIME_STRATEGIST_KEY=

# depositor: the account whose USDC enters the vault (enter-loop.sh does the
# requestDeposit). Must hold USDC before enter-loop runs. Reusable with owner.
PRIIME_DEPOSITOR_KEY=

# treasury: the account fund_account() transfers ETH and USDC from when
# funding operator EOAs and seeding the depositor. Must hold ETH (~0.02 ETH
# covers the initial 6-operator funding at operator_gas_wei=0.002 ETH each)
# and enough USDC to seed the demo deposit. Reusable with owner.
PRIIME_TREASURY_KEY=

# ---- loop-server auth ------------------------------------------------------

# Bearer token for POST /api/loops. Min 16 chars. Generate: openssl rand -hex 24
LOOP_SERVER_TOKEN=

# ---- optional overrides ---------------------------------------------------

# Override the target's default cron. Format: 6-field cron (seconds
# granularity). Default in deploy/targets/mainnet.json is `0 * * * * *`
# (every minute). Leave commented to use the target default.
# CRON_SCHEDULE_OVERRIDE=

# Journal reader scan-back window at boot. Defaults to a rolling 10k blocks.
# Set to the deploy block if you want the reader to see history from day zero.
# JOURNAL_FROM_BLOCK=
